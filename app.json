{
  "expo": {
    "name": "Gardio",
    "slug": "gardio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gardio-icon.png",
    "scheme": "gardio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.gardio"
    },
    "android": {
      "package": "br.gardio",
      "softwareKeyboardLayoutMode": "resize",
      "notification": {
        "icon": "./assets/images/notification-icon.png",
        "color": "#1d4ed8"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gardio-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1d4ed8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42a44eb4-7989-413b-8e5a-03051b74eb79"
      }
    },
    "owner": "luasndev"
  }
}
