{
  "expo": {
    "name": "Gardio",
    "slug": "gardio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gardio-icon.png",
    "scheme": "gardio",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.gardio"
    },
    "android": {
      "package": "br.gardio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gardio-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#1d4ed8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7a03be82-fa44-41cd-badf-87d7556a6f38"
      }
    }
  }
}
